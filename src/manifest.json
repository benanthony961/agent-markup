{
  "manifest_version": 3,
  "name": "Agent Markup",
  "version": "0.2.0",
  "description": "Visually edit any live website, then copy one precise prompt for your coding agent.",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Toggle Agent Markup (Alt+Shift+R)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Toggle Agent Markup on the current tab"
    }
  }
}
